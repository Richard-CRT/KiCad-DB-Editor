<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RootNamespace>KiCad_DB_Editor</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <Version>6.0.1</Version>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>$(ProjectDir)sgKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
	  <None Remove="View\Resources\Component.png" />
	  <None Remove="View\Resources\ComponentFolder.png" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
	  <Resource Include="View\Resources\Component.png" />
	  <Resource Include="View\Resources\ComponentFolder.png" />
  </ItemGroup>

  <ItemGroup>
	  <Compile Update="Properties\Settings.Designer.cs">
		  <DesignTimeSharedInput>True</DesignTimeSharedInput>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	  <Compile Update="View\Dialogs\Window_ConfirmDialog.xaml.cs">
		  <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="View\Dialogs\Window_ErrorDialog.xaml.cs">
		  <SubType>Code</SubType>
	  </Compile>
  </ItemGroup>

  <ItemGroup>
	  <None Update="Properties\Settings.settings">
		  <Generator>SettingsSingleFileGenerator</Generator>
		  <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
  </ItemGroup>

  <ItemGroup>
	  <Page Update="View\UserControl_Category.xaml">
		  <Generator>MSBuild:Compile</Generator>
	  </Page>
  </ItemGroup>

</Project>
